<Window x:Class="MDVTool.FolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择保存位置" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource Bg}" FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="False" UseLayoutRounding="True" FontSize="12.5"
        Foreground="{DynamicResource Text}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="{DynamicResource Bg}"
                  MouseLeftButtonDown="Header_MouseDown">
                <TextBlock Text="选择保存位置" FontSize="12.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Style="{StaticResource WinCloseBtn}" HorizontalAlignment="Right"
                        Click="Cancel_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="关闭">
                    <Path Data="M0,0 L10,10 M10,0 L0,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1" Width="10" Height="10" Stretch="None"/>
                </Button>
            </Grid>

            <!-- 内容 -->
            <StackPanel Grid.Row="1" Margin="16,0,16,0">
                <Border Background="{DynamicResource Card}" CornerRadius="10" Padding="14"
                        BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="NameText" FontSize="12" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="MetaText" Style="{StaticResource DimText}"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="保存到" FontSize="12.5" FontWeight="SemiBold" Margin="0,16,0,8"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PrefixText" Text="models\" VerticalAlignment="Center"
                               Foreground="{DynamicResource Dim}"
                               FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                               Margin="0,0,4,0"/>
                    <ComboBox x:Name="FolderCombo" Grid.Column="1" Style="{StaticResource DarkCombo}"
                              Height="34" IsEditable="True" FontFamily="{StaticResource MonoFont}"
                              FontSize="11.5" TextBoxBase.TextChanged="FolderCombo_TextChanged"/>
                    <Button Grid.Column="2" Content="浏览…" Style="{StaticResource Ghost}"
                            Margin="8,0,0,0" Height="34" Click="Browse_Click"/>
                </Grid>

                <TextBlock x:Name="HintText" Style="{StaticResource DimText}" Margin="0,8,0,0"
                           TextWrapping="Wrap"/>

                <Border Background="{DynamicResource PanelSoft}" CornerRadius="8" Padding="12,10"
                        Margin="0,14,0,0">
                    <CheckBox x:Name="DefaultCheck" Style="{StaticResource Switch}"
                              Content="设为默认位置，以后新建任务不再询问"/>
                </Border>
            </StackPanel>

            <!-- 按钮 -->
            <Grid Grid.Row="2" Margin="16,16,16,14">
                <TextBlock x:Name="PathPreview" Style="{StaticResource DimText}" VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}" FontSize="10.5"
                           TextTrimming="CharacterEllipsis" Margin="0,0,150,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource Ghost}" Click="Cancel_Click" Margin="0,0,8,0"/>
                    <Button Content="开始下载" Style="{StaticResource Primary}" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
