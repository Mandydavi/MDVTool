<Window x:Class="MDVTool.RepoPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择要下载的文件" Width="780" Height="560"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="{StaticResource Bg}" FontFamily="{StaticResource UiFont}"
        ShowInTaskbar="False" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Border}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource Bg}" MouseLeftButtonDown="Header_MouseDown">
                <TextBlock Text="选择要下载的文件" FontSize="12.5" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                <Button Style="{StaticResource WinCloseBtn}" HorizontalAlignment="Right"
                        Click="Cancel_Click" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="关闭">
                    <Path Data="M0,0 L10,10 M10,0 L0,10"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1" Width="10" Height="10" Stretch="None"/>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1" Margin="16,2,16,10">
                <TextBlock x:Name="RepoText" Style="{StaticResource DimText}"/>
                <TextBlock Text="Ctrl / Shift 可多选，文件会按类型自动归到 models 的子目录"
                           Style="{StaticResource DimText}" FontSize="10.5" Margin="0,4,0,0"/>
            </StackPanel>

            <Border Grid.Row="2" Margin="16,0,16,0" Background="{StaticResource Card}" CornerRadius="10"
                    BorderBrush="{StaticResource BorderSoft}" BorderThickness="1" Padding="6">
                <ListBox x:Name="FileList" Background="Transparent" BorderThickness="0"
                         SelectionMode="Extended" SelectionChanged="FileList_SelectionChanged"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="bd" Background="Transparent" CornerRadius="7" Padding="9,8">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#1D2432"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="bd" Property="Background"
                                                        Value="{StaticResource AccentSoft}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="26" Height="26" CornerRadius="6"
                                        Background="{StaticResource AccentSoft}" VerticalAlignment="Center">
                                    <Path Data="M3,1 H9 L12,4 V14 H3 Z M9,1 V4 H12"
                                          Stroke="{StaticResource AccentHover}" StrokeThickness="1"
                                          Width="11" Height="11" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding DirText}" Style="{StaticResource DimText}"
                                               FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource DimText}"
                                           FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Grid Grid.Row="3" Margin="16,12,16,14">
                <TextBlock x:Name="SelText" Style="{StaticResource DimText}" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="全选" Style="{StaticResource Ghost}" Click="SelectAll_Click" Margin="0,0,8,0"/>
                    <Button Content="下载选中" Style="{StaticResource Primary}" Click="Ok_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
