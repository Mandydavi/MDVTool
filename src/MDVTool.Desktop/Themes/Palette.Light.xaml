<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         调色板：浅色（v2 全新设计）
         层级：Bg #F4F6FA < Sidebar #EDF1F7 < Card #FFFFFF
         ============================================================ -->

    <!-- 表面 -->
    <SolidColorBrush x:Key="Bg" Color="#F4F6FA"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#EDF1F7"/>
    <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardHover" Color="#F6F8FC"/>
    <SolidColorBrush x:Key="CardSel" Color="#EAEFF6"/>
    <SolidColorBrush x:Key="Surface2" Color="#F6F8FC"/>
    <SolidColorBrush x:Key="Surface3" Color="#EAEFF6"/>

    <!-- 描边 -->
    <SolidColorBrush x:Key="Border" Color="#E0E6EF"/>
    <SolidColorBrush x:Key="BorderSoft" Color="#EAEFF5"/>
    <SolidColorBrush x:Key="BorderHover" Color="#C6D0DE"/>

    <!-- 文字 -->
    <SolidColorBrush x:Key="Text" Color="#151C28"/>
    <SolidColorBrush x:Key="Sub" Color="#4E5C70"/>
    <SolidColorBrush x:Key="Dim" Color="#7A889C"/>
    <SolidColorBrush x:Key="Text3" Color="#7A889C"/>
    <SolidColorBrush x:Key="TextMuted" Color="#4E5C70"/>
    <SolidColorBrush x:Key="Faint" Color="#C6D0DE"/>

    <!-- 品牌色：冰蓝 -->
    <SolidColorBrush x:Key="Accent" Color="#2563EB"/>
    <SolidColorBrush x:Key="Accent2" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="AccentHover" Color="#3B82F6"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#E7EDFB"/>
    <SolidColorBrush x:Key="AccentDisabled" Color="#B9C6F5"/>
    <SolidColorBrush x:Key="BrandSoft" Color="#E7EDFB"/>
    <SolidColorBrush x:Key="AccentRing" Color="#292563EB"/>

    <!-- 心动色：支持作者 -->
    <SolidColorBrush x:Key="Heart" Color="#E65A7D"/>
    <SolidColorBrush x:Key="Heart2" Color="#F0A35E"/>
    <SolidColorBrush x:Key="HeartSoft" Color="#FCEEF2"/>

    <!-- 品牌渐变（标题栏 Logo / 主按钮） -->
    <LinearGradientBrush x:Key="BrandGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2563EB" Offset="0"/>
        <GradientStop Color="#1D4ED8" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeartGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E65A7D" Offset="0"/>
        <GradientStop Color="#F0A35E" Offset="1"/>
    </LinearGradientBrush>

    <!-- 状态色（文字） -->
    <SolidColorBrush x:Key="Green" Color="#0E8A57"/>
    <SolidColorBrush x:Key="Red" Color="#D43A50"/>
    <SolidColorBrush x:Key="Amber" Color="#9A6B00"/>

    <!-- 状态色（底色） -->
    <SolidColorBrush x:Key="SuccessSoft" Color="#E7F6EC"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#FCEDEB"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#FDF1DF"/>

    <!-- 文件类型徽章 -->
    <SolidColorBrush x:Key="TypeSft" Color="#1E4FD8"/>
    <SolidColorBrush x:Key="TypeSftSoft" Color="#E9EEFF"/>
    <SolidColorBrush x:Key="TypeCkpt" Color="#6B3FD4"/>
    <SolidColorBrush x:Key="TypeCkptSoft" Color="#F1EBFF"/>
    <SolidColorBrush x:Key="TypeGguf" Color="#0B7285"/>
    <SolidColorBrush x:Key="TypeGgufSoft" Color="#E2F5F8"/>
    <SolidColorBrush x:Key="TypeMisc" Color="#4B5A72"/>
    <SolidColorBrush x:Key="TypeMiscSoft" Color="#EDF1F7"/>

    <!-- 控件 -->
    <SolidColorBrush x:Key="FieldBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="GhostBg" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HoverSoft" Color="#F6F8FC"/>
    <SolidColorBrush x:Key="RowHover" Color="#F6F8FC"/>
    <SolidColorBrush x:Key="RowSel" Color="#EAEFF6"/>
    <SolidColorBrush x:Key="ItemHover" Color="#F1F4F9"/>
    <SolidColorBrush x:Key="PanelSoft" Color="#F7F9FD"/>
    <SolidColorBrush x:Key="PanelAlt" Color="#FAFBFD"/>

    <SolidColorBrush x:Key="TrackBg" Color="#E9EDF4"/>
    <SolidColorBrush x:Key="ThumbBg" Color="#C7D0DE"/>
    <SolidColorBrush x:Key="SwitchOff" Color="#C6D0DE"/>
    <SolidColorBrush x:Key="Knob" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="CloseHover" Color="#E5484D"/>
    <SolidColorBrush x:Key="Scrim" Color="#5C0C1422"/>

    <!-- 注意：Shadow 是 Color 而不是 Brush，DropShadowEffect.Color 只认 Color -->
    <Color x:Key="Shadow">#0F1A2B</Color>

</ResourceDictionary>
