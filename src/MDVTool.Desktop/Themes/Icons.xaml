    <!-- ============================================================
         统一矢量图标库 · 24x24 viewBox / 线性描边 / 当前色
         来源：docs/reference/全新设计-可交互原型-v2.html 的 GLYPH（已由用户确认）
         不依赖 Segoe Fluent Icons 等系统字体，换机器不会缺字变方块
         每个 SVG 元素已独立绝对化后拼接，杜绝相对命令错位
         ============================================================ -->

    <Style TargetType="{x:Type ctrl:VectorIcon}">
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ctrl:VectorIcon}">
                    <Path Data="{TemplateBinding Shape}" Stretch="Uniform"
                          Stroke="{TemplateBinding Foreground}" StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          StrokeLineJoin="Round" Fill="Transparent"
                          SnapsToDevicePixels="True"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

