<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MDVTool</AssemblyName>
    <RootNamespace>MDVTool</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.2.0</Version>
    <Product>MDV Tool</Product>
    <AssemblyTitle>MDV Tool</AssemblyTitle>
    <Company>Mandydavi</Company>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
    <Resource Include="Assets\app-logo.png" />
    <Resource Include="Assets\app-icon.png" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\reward-wechat.jpg" />
    <Resource Include="Assets\reward-alipay.jpg" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\.\.\bin\aria2c.exe')">
    <None Include="\.\.\bin\aria2c.exe" CopyToOutputDirectory="PreserveNewest" Link="aria2c.exe"/>
  </ItemGroup>

</Project>
