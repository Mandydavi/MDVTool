                        <!-- ============================================================
                             运行日志：底部全局抽屉
                             ============================================================ -->
                        <Border x:Name="PanelLog" Height="252" VerticalAlignment="Bottom"
                                Panel.ZIndex="28" Visibility="Collapsed"
                                Background="{DynamicResource Card}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="LogShift" Y="252"/>
                            </Border.RenderTransform>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.14" Color="{DynamicResource Shadow}"/>
                            </Border.Effect>

                            <Grid Margin="20,12,16,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="运行日志" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="最近 500 条 · 自动滚到最新" Style="{StaticResource DimText}"
                                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="清空" Style="{StaticResource TextBtn}" Click="ClearLog_Click"/>
                                        <Button Style="{StaticResource IconBtn}" Click="CloseLog_Click" ToolTip="收起">
                                            <ctrl:VectorIcon Kind="x" Width="13" Height="13"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1" Background="{DynamicResource Surface2}" CornerRadius="10"
                                        BorderBrush="{DynamicResource BorderSoft}" BorderThickness="1" Padding="12,10,6,10">
                                    <Grid>
                                        <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" Padding="0"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 VirtualizingPanel.IsVirtualizing="True"
                                                 VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem">
                                                    <Setter Property="Padding" Value="0"/>
                                                    <Setter Property="Margin" Value="0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBoxItem">
                                                                <ContentPresenter/>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,5">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}"
                                                                   FontSize="10" Foreground="{DynamicResource Dim}"
                                                                   Margin="0,2,10,0" VerticalAlignment="Top"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="12"
                                                                   TextWrapping="Wrap" Foreground="{DynamicResource Sub}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock x:Name="LogEmpty" Text="暂无日志" Style="{StaticResource DimText}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,10,0,0"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

