                                                    <TextBlock Text="{Binding FileName}" FontSize="13" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                                               Foreground="{DynamicResource Dim}" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="2" Style="{StaticResource StatusPill}"
                                                        Tag="{Binding StatusKind}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}"/>
                                                </Border>
                                            </Grid>
