                            <Border Width="540" Background="{DynamicResource Card}" CornerRadius="16"
                                    MouseLeftButtonDown="DonateSheet_Click"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="44" ShadowDepth="12" Opacity="0.30"
                                                      Color="{DynamicResource Shadow}"/>
                                </Border.Effect>
                                <StackPanel Margin="28,24,28,22">
                                    <TextBlock Text="支持作者" FontSize="17" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="软件完全免费、源码开放，打赏全凭自愿，不影响任何功能"
                                               Style="{StaticResource DimText}" Margin="0,7,0,0"
                                               TextAlignment="Center" TextWrapping="Wrap"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                Margin="0,20,0,0">
                                        <StackPanel VerticalAlignment="Top">
                                            <TextBlock Text="微信支付" FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                    CornerRadius="8" Padding="0"
                                                    Background="White">
                                                <Image Source="/Assets/reward-wechat.jpg" Width="188"
                                                       Stretch="Uniform"/>
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Margin="26,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="支付宝" FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
                                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                                    CornerRadius="8" Padding="0"
                                                    Background="White">
                                                <Image Source="/Assets/reward-alipay.jpg" Width="188"
                                                       Stretch="Uniform"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Text="扫码即可，金额随意。谢谢你的支持。"
                                               Style="{StaticResource DimText}" Margin="0,18,0,0"
                                               TextAlignment="Center"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                Margin="0,16,0,0">
                                        <Button Content="关闭" Style="{StaticResource Ghost}"
                                                Click="CloseDonate_Click"/>
                                        <Button Content="打开项目主页" Style="{StaticResource MiniBtn}"
                                                Margin="10,0,0,0" Click="OpenRepo_Click"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
        </Grid>
    </Border>
</Window>
