                                                </Border>
                                            </StackPanel>
                                        </Border>

                                        <StackPanel Grid.Column="2">
                                            <Border Style="{StaticResource SettingCard}">
                                                <StackPanel>
                                                    <Border Style="{StaticResource SettingRow}">
                                                        <Grid>
                                                            <StackPanel>
                                                                <TextBlock Text="极速多源并发" FontSize="12.5" FontWeight="SemiBold"/>
