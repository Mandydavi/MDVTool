                                                     FontSize="13" MinWidth="420" VerticalContentAlignment="Center"
                                                     KeyDown="SniffUrl_KeyDown"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource Primary}" Height="34"
                                                Padding="20,0" Click="Sniff_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <ctrl:VectorIcon Kind="radar" Width="13" Height="13"
                                                                 VerticalAlignment="Center"/>
