                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="14"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Style="{StaticResource SettingCard}" VerticalAlignment="Top">
                                            <StackPanel>
                                                <Border Style="{StaticResource SettingRow}">
                                                    <Grid>
                                                        <StackPanel>
                                                            <TextBlock Text="同时下载" FontSize="12.5" FontWeight="SemiBold"/>
