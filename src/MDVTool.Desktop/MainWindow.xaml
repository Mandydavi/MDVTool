<Window x:Class="MDVTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:MDVTool.Controls"
        xmlns:local="clr-namespace:MDVTool"
        Title="MDV Tool"
        Icon="app.ico"
        Width="1280" Height="800" MinWidth="1060" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Bg}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{DynamicResource Text}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseWheel="Window_PreviewMouseWheel"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="8" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <local:PathWrapConverter x:Key="PathWrap"/>

        <!-- ============================================================
             v9 · 进行中的任务：三段式大卡片
             顶部 名称/来源/速度 → 中部 进度条 + 百分比 → 底部 状态胶囊 + 操作
             ============================================================ -->
        <DataTemplate x:Key="RowRunning">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 左侧 2px 强调条：下载中=蓝，暂停=黄，失败=红 -->
                <Border Grid.RowSpan="3" Width="2" HorizontalAlignment="Left"
                        CornerRadius="1" Margin="0,10,0,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource Accent}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusKind}" Value="paused">
                                    <Setter Property="Background" Value="{DynamicResource Amber}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusKind}" Value="failed">
                                    <Setter Property="Background" Value="{DynamicResource Red}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                </Border>

                <Grid Grid.Row="0" Margin="14,12,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}" VerticalAlignment="Center"
                              ToolTip="选择任务"
                              IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"/>

                    <Border Grid.Column="1" Style="{StaticResource TypeBadge}" Tag="{Binding BadgeText}"
                            Width="38" Height="38" CornerRadius="9" Margin="12,0,0,0"
                            TextElement.FontSize="10" VerticalAlignment="Center">
                        <ctrl:VectorIcon Kind="{Binding BadgeIcon}" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding BadgeText}"/>
                    </Border>

                    <StackPanel Grid.Column="2" Margin="11,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding HostShort}" FontSize="10.5"
                                       Foreground="{DynamicResource Dim}"/>
                            <TextBlock Text="·" FontSize="10.5" Margin="5,0"
                                       Foreground="{DynamicResource Dim}"/>
                            <Border Background="{DynamicResource Surface2}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    CornerRadius="4" Padding="6,1" MaxWidth="360">
                                <TextBlock Text="{Binding TargetLine}" FontSize="10"
                                           FontFamily="{StaticResource MonoFont}"
                                           Foreground="{DynamicResource Sub}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding DestPath}"/>
                            </Border>
                            <TextBlock Text="·" FontSize="10.5" Margin="5,0"
                                       Foreground="{DynamicResource Dim}"/>
                            <TextBlock Text="{Binding SizeLine}" FontSize="10.5"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{DynamicResource Dim}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                                MinWidth="112">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding SpeedNumber}" FontSize="19" FontWeight="SemiBold"
                                       FontFamily="{StaticResource MonoFont}"
                                       Foreground="{DynamicResource Accent}"/>
                            <TextBlock Text="MB/s" FontSize="10" Margin="3,0,0,2"
                                       VerticalAlignment="Bottom"
                                       Foreground="{DynamicResource Dim}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding EtaText}" FontSize="10.5" Margin="0,2,0,0"
                                   FontFamily="{StaticResource MonoFont}"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource Dim}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="16,0,16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ProgressBar Value="{Binding Pct, Mode=OneWay}" Maximum="100" Height="6"
                                 Style="{StaticResource ProgressRow}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{Binding PctText}" FontSize="12" FontWeight="SemiBold"
                               FontFamily="{StaticResource MonoFont}" Margin="11,0,0,0" Width="44"
                               TextAlignment="Right"
                               Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                </Grid>

                <Border Grid.Row="2" Margin="16,12,16,0" BorderBrush="{DynamicResource Border}"
                        BorderThickness="0,1,0,0" Padding="0,11,0,0">
                    <Grid>
                        <Border Style="{StaticResource StatusPill}" Tag="{Binding StatusKind}"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}"/>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource RowTextAction}" Click="CancelTask_Click"
                                    Visibility="{Binding IsActive, Converter={StaticResource B2V}}">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:VectorIcon Kind="pause" Width="12" Height="12"/>
                                    <TextBlock Text="暂停" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RowTextAction}" Click="ResumeTask_Click" Margin="5,0,0,0"
                                    Visibility="{Binding CanResume, Converter={StaticResource B2V}}">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:VectorIcon Kind="play" Width="12" Height="12"/>
                                    <TextBlock Text="继续" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RowTextAction}" Click="OpenTaskFolder_Click"
                                    Margin="5,0,0,0" ToolTip="{Binding FolderHint}">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:VectorIcon Kind="folder-open" Width="12" Height="12"/>
                                    <TextBlock Text="打开" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RowTextAction}" Click="CopyTaskUrl_Click"
                                    Margin="5,0,0,0" ToolTip="复制链接">
                                <StackPanel Orientation="Horizontal">
                                    <ctrl:VectorIcon Kind="copy" Width="12" Height="12"/>
                                    <TextBlock Text="复制" Margin="5,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource RowTextAction}" Click="TaskDetail_Click"
                                    Margin="5,0,0,0" ToolTip="查看详情">
                                <TextBlock Text="详情"/>
                            </Button>
                            <Button Style="{StaticResource RowTextAction}" Click="RemoveTask_Click"
                                    Margin="5,0,0,0" ToolTip="移除">
                                <ctrl:VectorIcon Kind="x" Width="12" Height="12"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- ============================================================
             v9 · 等待 / 已完成：紧凑行（46px），已完成整体降权
             ============================================================ -->
        <DataTemplate x:Key="RowCompact">
            <Grid Height="46">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusKind}" Value="done">
                                <Setter Property="Opacity" Value="0.72"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid Margin="14,0,14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="86"/>
                        <ColumnDefinition Width="118"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" Style="{StaticResource RowCheck}" VerticalAlignment="Center"
                              ToolTip="选择任务"
                              IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"/>

                    <Border Grid.Column="1" Style="{StaticResource TypeBadge}" Tag="{Binding BadgeText}"
                            Width="26" Height="26" CornerRadius="7" Margin="11,0,0,0"
                            TextElement.FontSize="7.5" VerticalAlignment="Center">
                        <ctrl:VectorIcon Kind="{Binding BadgeIcon}" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding BadgeText}"/>
                    </Border>

                    <TextBlock Grid.Column="2" Text="{Binding DisplayName}" FontSize="12"
                               Margin="11,0,10,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>

                    <TextBlock Grid.Column="3" Text="{Binding TotalText}" FontSize="10.5"
                               Foreground="{DynamicResource Dim}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}"/>

                    <TextBlock Grid.Column="4" Text="{Binding TargetLine}" FontSize="10.5"
                               Foreground="{DynamicResource Dim}" VerticalAlignment="Center"
                               HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                               Margin="12,0,0,0" ToolTip="{Binding DestPath}"/>

                    <Border Grid.Column="5" Style="{StaticResource StatusPill}" Tag="{Binding StatusKind}"
                            Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusText}"/>
                    </Border>

                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="8,0,0,0">
                        <Button Style="{StaticResource RowAction}" Click="ResumeTask_Click" ToolTip="继续"
                                Visibility="{Binding CanResume, Converter={StaticResource B2V}}">
                            <ctrl:VectorIcon Kind="play" Width="13" Height="13"/>
                        </Button>
                        <Button Style="{StaticResource RowAction}" Click="OpenTaskFolder_Click"
                                ToolTip="{Binding FolderHint}">
                            <ctrl:VectorIcon Kind="folder-open" Width="13" Height="13"/>
                        </Button>
                        <Button Style="{StaticResource RowAction}" Click="CopyTaskUrl_Click" ToolTip="复制链接">
                            <ctrl:VectorIcon Kind="copy" Width="13" Height="13"/>
                        </Button>
                        <Button Style="{StaticResource RowTextAction}" Click="TaskDetail_Click"
                                Margin="2,0,0,0" ToolTip="查看详情">
                            <TextBlock Text="详情"/>
                        </Button>
                        <Button Style="{StaticResource RowAction}" Click="RemoveTask_Click" ToolTip="移除">
                            <ctrl:VectorIcon Kind="x" Width="13" Height="13"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>
        </DataTemplate>

        <local:TaskRowSelector x:Key="RowSelector"
                               Running="{StaticResource RowRunning}"
                               Compact="{StaticResource RowCompact}"/>
    </Window.Resources>

    <Border x:Name="WindowFrame" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderSoft}"
            BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- ============================================================
                 v2 标题栏：品牌 / 页面名 / 引擎状态 / 全局入口 / 窗口按钮
                 ============================================================ -->
            <Grid Grid.Row="0" Background="{DynamicResource SidebarBg}"
                  MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Image Source="Assets/app-icon.png" Width="29" Height="29" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MDV Tool" FontSize="13.5" FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource Surface3}" CornerRadius="4" Padding="5,0"
                                    Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="VersionBadge" Text="v0" FontSize="9"
                                           FontWeight="SemiBold" FontFamily="{StaticResource MonoFont}"
                                           Foreground="{DynamicResource Dim}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="多源极速下载" FontSize="9.5" Margin="0,1,0,0"
                                   FontFamily="{StaticResource MonoFont}"
                                   Foreground="{DynamicResource Dim}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="22,0,0,0">
                    <TextBlock x:Name="PageTitleText" Text="工作台" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Border Width="1" Height="16" Background="{DynamicResource BorderHover}"
                            Margin="12,0" VerticalAlignment="Center"/>
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Green}" VerticalAlignment="Center"/>
                    <TextBlock Text="引擎就绪 · aria2c" FontSize="11" Margin="7,0,0,0"
                               Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBtn}" Click="NewTask_Click" ToolTip="回到工作台并聚焦输入框">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:VectorIcon Kind="plus" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="新建下载" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource TitleHeartBtn}" Margin="7,0,0,0" Click="OpenDonate_Click"
                            ToolTip="支持作者">
                        <StackPanel Orientation="Horizontal">
                            <ctrl:VectorIcon Kind="heart" Width="14" Height="14" VerticalAlignment="Center"/>
                            <TextBlock Text="支持作者" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource TitleIconBtn}" Margin="7,0,0,0"
                            Click="ThemeToggle_Click" ToolTip="切换浅色 / 深色">
                        <ctrl:VectorIcon Kind="sun" Width="15" Height="15" x:Name="ThemeGlyph"/>
                    </Button>

                    <Button x:Name="PaletteBtn" Style="{StaticResource TitleIconBtn}" Margin="4,0,0,0"
                            Click="Palette_Click" ToolTip="切换界面配色">
                        <ctrl:VectorIcon Kind="palette" Width="15" Height="15" Foreground="{DynamicResource Accent}"/>
                    </Button>

                    <StackPanel Orientation="Horizontal" Margin="6,0,0,0">
                        <Button Style="{StaticResource WinBtn}" Click="Min_Click" ToolTip="最小化">
                            <Path Data="M0,5 L10,5"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Width="10" Height="10" Stretch="None"/>
                        </Button>
                        <Button Style="{StaticResource WinBtn}" Click="Max_Click" ToolTip="最大化">
                            <Grid Width="10" Height="10">
                                <Path x:Name="MaxIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1" Stretch="None"/>
                                <Path x:Name="RestoreIcon" Data="M0.5,2.5 H7.5 V9.5 H0.5 Z M2.5,2.5 V0.5 H9.5 V7.5 H7.5"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1" Stretch="None" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource WinCloseBtn}" Click="Close_Click" ToolTip="关闭">
                            <Path Data="M0,0 L10,10 M10,0 L0,10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1" Width="10" Height="10" Stretch="None"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- ============================================================
                 图标栏 + 主内容
                 ============================================================ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="208"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== 侧栏 ===== -->
                <Border Grid.Column="0" Background="{DynamicResource SidebarBg}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0"
                        Padding="12,20,12,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="工作" Style="{StaticResource NavLabel}" Margin="12,2,0,6"/>

                            <RadioButton x:Name="NavTasks" Style="{StaticResource NavItem}" GroupName="Nav"
                                         IsChecked="True" Checked="Nav_Checked" Tag="tasks">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ctrl:VectorIcon Kind="grid" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="下载列表" Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Style="{StaticResource NavCount}">
                                        <TextBlock x:Name="NavTaskCount" Text="0"/>
                                    </Border>
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="NavFolder" Style="{StaticResource NavItem}" GroupName="Nav"
                                         Checked="Nav_Checked" Tag="folder">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ctrl:VectorIcon Kind="cube" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="模型库" Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <Border Grid.Column="2" Style="{StaticResource NavCount}">
                                        <TextBlock x:Name="NavFolderCount" Text="0"/>
                                    </Border>
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="NavSniff" Style="{StaticResource NavItem}" GroupName="Nav"
                                         Checked="Nav_Checked" Tag="sniff">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ctrl:VectorIcon Kind="radar" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="资源嗅探" Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="NavQueue" Style="{StaticResource NavItem}" GroupName="Nav"
                                         Checked="Nav_Checked" Tag="queue">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ctrl:VectorIcon Kind="gauge" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="队列与限速" Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </RadioButton>

                            <TextBlock Text="系统" Style="{StaticResource NavLabel}" Margin="12,18,0,6"/>

                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavItem}" GroupName="Nav"
                                         Checked="Nav_Checked" Tag="settings">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ctrl:VectorIcon Kind="sliders" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="设置" Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </RadioButton>

                            <RadioButton x:Name="NavUpdate" Style="{StaticResource NavItem}" GroupName="Nav"
                                         Checked="Nav_Checked" Tag="update">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ctrl:VectorIcon Kind="refresh" Width="18" Height="18" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="更新" Margin="6,0,0,0"
                                               VerticalAlignment="Center"/>
                                    <Border x:Name="NavUpdateDot" Grid.Column="2" Width="7" Height="7"
                                            CornerRadius="4" Background="{DynamicResource Amber}"
                                            VerticalAlignment="Center" Visibility="Collapsed"/>
                                </Grid>
                            </RadioButton>

                        </StackPanel>

                        <StackPanel Grid.Row="1">
                            <Button Style="{StaticResource SideFootBtn}" Click="OpenDownloadDir_Click" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ctrl:VectorIcon Kind="folder-open" Width="13" Height="13" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="打开下载目录" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Sub}"/>
                                </StackPanel>
                            </Button>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SideFootBtn}" Click="ShowDesignNotes_Click">
                                    <TextBlock Text="设计说明" FontSize="11"/>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource SideFootBtn}"
                                        Click="SelfCheck_Click">
                                    <TextBlock Text="自检" FontSize="11"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== 主区 ===== -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">

                        <!-- ================= 队列 ================= -->
                        <ScrollViewer x:Name="TasksScroll" Focusable="False" Visibility="{Binding Visibility, ElementName=ViewTasks}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<Grid x:Name="ViewTasks" MaxWidth="1280" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- 捕获区 -->
                            <Border Grid.Row="0" Style="{StaticResource CardBox}"
                                    Margin="22,18,22,0" Padding="16,15,16,12">
                                <StackPanel>
                                    <Grid Margin="2,0,2,13">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="新建下载" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="粘一条链接，测速、选源、归类，剩下的交给它"
                                                       FontSize="11" Foreground="{DynamicResource Dim}"
                                                       Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                                    VerticalAlignment="Center">
                                            <Border Style="{StaticResource StatusPill}" Background="{DynamicResource Surface2}"
                                                    Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ctrl:VectorIcon Kind="zap" Width="12" Height="12" VerticalAlignment="Center"
                                                               Margin="0,0,4,0" Foreground="{DynamicResource Accent}"/>
                                                    <TextBlock Text="多源并发" FontSize="10.5"
                                                               Foreground="{DynamicResource Sub}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource StatusPill}" Background="{DynamicResource Surface2}"
                                                    Margin="0,0,6,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ctrl:VectorIcon Kind="layers" Width="12" Height="12" VerticalAlignment="Center"
                                                               Margin="0,0,4,0" Foreground="{DynamicResource Accent}"/>
                                                    <TextBlock Text="自动归类" FontSize="10.5"
                                                               Foreground="{DynamicResource Sub}"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource StatusPill}" Background="{DynamicResource Surface2}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ctrl:VectorIcon Kind="refresh" Width="12" Height="12" VerticalAlignment="Center"
                                                               Margin="0,0,4,0" Foreground="{DynamicResource Accent}"/>
                                                    <TextBlock Text="断点续传" FontSize="10.5"
                                                               Foreground="{DynamicResource Sub}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- 输入区：大输入框 + 独立底部操作条 -->
                                    <Border x:Name="CapBox" CornerRadius="12" Background="{DynamicResource FieldBg}"
                                            BorderBrush="{DynamicResource BorderHover}" BorderThickness="1"
                                            Padding="16,10,10,10"
                                            PreviewMouseLeftButtonDown="CapBox_PreviewMouseDown">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ctrl:VectorIcon Kind="link" Width="20" Height="20" Foreground="{DynamicResource Accent}"
                                                       VerticalAlignment="Center" Margin="0,0,12,0"/>

                                            <Grid Grid.Column="1" Background="Transparent">
                                                <TextBox x:Name="UrlBox" Style="{StaticResource CaptureInput}"
                                                         MinHeight="40" FontSize="14"
                                                         VerticalContentAlignment="Center"
                                                         TextChanged="UrlBox_TextChanged" KeyDown="UrlBox_KeyDown"/>
                                                <TextBlock x:Name="UrlHint" IsHitTestVisible="False"
                                                           VerticalAlignment="Center" Margin="2,0,0,0"
                                                           Foreground="{DynamicResource Dim}" FontSize="13"
                                                           Text="粘贴下载链接，或把 .torrent 拖进来">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Text, ElementName=UrlBox}" Value=""/>
                                                                        <Condition Binding="{Binding IsKeyboardFocused, ElementName=UrlBox}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>

                                            <Button Grid.Column="2" Style="{StaticResource MiniBtn}" Height="30"
                                                    Margin="8,0,0,0" Click="PasteUrl_Click" ToolTip="从剪贴板粘贴">
                                                <StackPanel Orientation="Horizontal">
                                                    <ctrl:VectorIcon Kind="clipboard" Width="13" Height="13" VerticalAlignment="Center"/>
                                                    <TextBlock Text="粘贴" Margin="5,0,0,0" FontSize="11"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="3" Style="{StaticResource MiniIconBtn}"
                                                    Margin="2,0,0,0" Click="ClearUrl_Click" ToolTip="清空">
                                                <ctrl:VectorIcon Kind="x" Width="12" Height="12"/>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- 底部操作条：识别结果 · 保存位置 · 种子入口 · 主按钮 -->
                                    <Grid Margin="2,12,2,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid Grid.Column="0" Margin="0,0,12,0" MaxWidth="430" HorizontalAlignment="Left">
                                            <TextBlock x:Name="CapDefaultHint"
                                                       Text="任何链接都能下：软件 / 压缩包 / 镜像 / 视频；模型会自动归到 ComfyUI 目录"
                                                       FontSize="11.5" Foreground="{DynamicResource Dim}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=InfoText}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock x:Name="InfoText" FontSize="11.5" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Accent}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </Grid>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource Chip}" Height="30" Padding="9,0"
                                                    Margin="0,0,10,0" Click="PickTargetFolder_Click"
                                                    ToolTip="选择保存位置">
                                                <StackPanel Orientation="Horizontal">
                                                    <ctrl:VectorIcon Kind="folder" Width="13" Height="13" VerticalAlignment="Center"/>
                                                    <TextBlock x:Name="TargetChipText" Text="自动归类" FontSize="11"
                                                               Margin="5,0,0,0" VerticalAlignment="Center"/>
                                                    <ctrl:VectorIcon Kind="chevron-down" Width="12" Height="12" Margin="6,1,0,0" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Dim}"/>
                                                </StackPanel>
                                            </Button>

                                            <TextBlock Text="保存到" FontSize="11.5"
                                                       Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="CapTargetText" Text="models" FontSize="11.5"
                                                       Foreground="{DynamicResource Sub}" Margin="5,0,12,0"
                                                       MaxWidth="150" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>

                                            <Button Style="{StaticResource MiniBtn}" Height="30" Margin="0,0,6,0"
                                                    Click="BtPick_Click" ToolTip="选择一个 .torrent 文件">
                                                <StackPanel Orientation="Horizontal">
                                                    <ctrl:VectorIcon Kind="file" Width="13" Height="13" VerticalAlignment="Center"/>
                                                    <TextBlock Text="选择 .torrent" Margin="5,0,0,0" FontSize="11"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>

                                            <Button x:Name="StartBtn" Style="{StaticResource Primary}"
                                                    Height="34" Padding="16,0" Click="AddTask_Click">
                                                <StackPanel Orientation="Horizontal">
                                                    <ctrl:VectorIcon Kind="download" Width="15" Height="15" VerticalAlignment="Center"/>
                                                    <TextBlock Text="开始下载" Margin="7,0,0,0" FontSize="12.5"
                                                               VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- 仪表盘 -->
                            <Border Grid.Row="1" Margin="22,12,22,0" Background="{DynamicResource Card}"
                                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    CornerRadius="13">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.05*" MinWidth="210"/>
                                        <ColumnDefinition Width="1*" MinWidth="190"/>
                                        <ColumnDefinition Width=".6*" MinWidth="112"/>
                                        <ColumnDefinition Width=".6*" MinWidth="112"/>
                                        <ColumnDefinition Width=".6*" MinWidth="112"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Margin="18,14,18,14" VerticalAlignment="Center">
                                        <TextBlock Text="实时下载速度" Style="{StaticResource DashKicker}"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="SpeedBig" Text="0.0" FontSize="33" FontWeight="SemiBold"
                                                       FontFamily="{StaticResource MonoFont}"/>
                                            <TextBlock x:Name="SpeedUnit" Text="MB/s" FontSize="13"
                                                       Foreground="{DynamicResource Dim}"
                                                       VerticalAlignment="Bottom" Margin="5,0,0,5"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DashSub" Text="0 个任务在跑 · 多源并发生效"
                                                   FontSize="11" Foreground="{DynamicResource Dim}"
                                                   Margin="0,5,0,0"/>
                                        <StackPanel Visibility="Collapsed">
                                            <TextBlock x:Name="UpText" Text="0.0 MB/s"/>
                                            <TextBlock x:Name="EtaText" Text="--"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Grid.Column="1" BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1,0,0,0" Padding="16,14">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="近 30 秒吞吐" Style="{StaticResource DashKicker}"
                                                       Margin="0,0,0,6"/>
                                            <ctrl:Sparkline x:Name="SpeedChart" Height="44"
                                                            HorizontalAlignment="Stretch"
                                                            LineBrush="{DynamicResource Accent}">
                                                <ctrl:Sparkline.FillBrush>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#336AA9FF" Offset="0"/>
                                                        <GradientStop Color="#006AA9FF" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </ctrl:Sparkline.FillBrush>
                                            </ctrl:Sparkline>
                                            <Grid Margin="0,6,0,0">
                                                <TextBlock Text="0s" FontSize="10"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{DynamicResource Dim}"/>
                                                <TextBlock x:Name="SparkPeak" Text="峰值 12 MB/s" FontSize="10"
                                                           HorizontalAlignment="Center"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{DynamicResource Dim}"/>
                                                <TextBlock Text="30s" FontSize="10" HorizontalAlignment="Right"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{DynamicResource Dim}"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1,0,0,0" Padding="18,14">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="进行中 / 排队" Style="{StaticResource DashKicker}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock x:Name="DashActive" Text="0" FontSize="20"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text=" / " FontSize="12"
                                                           Foreground="{DynamicResource Dim}"
                                                           VerticalAlignment="Bottom" Margin="2,0"/>
                                                <TextBlock x:Name="DashQueue" Text="0" FontSize="12"
                                                           Foreground="{DynamicResource Dim}"
                                                           VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                                            </StackPanel>
                                            <ProgressBar x:Name="DashActiveBar" Height="3" Margin="0,7,0,0"
                                                         Maximum="100" Value="0"
                                                         Foreground="{DynamicResource Accent}"/>
                                            <TextBlock Text="并发上限 自动" FontSize="10.5"
                                                       Foreground="{DynamicResource Dim}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="3" BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1,0,0,0" Padding="18,14">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="今日累计" Style="{StaticResource DashKicker}"/>
                                            <TextBlock x:Name="DashToday" Text="0 B" FontSize="20"
                                                       FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"/>
                                            <ProgressBar x:Name="DashTodayBar" Height="3" Margin="0,7,0,0"
                                                         Maximum="100" Value="0"
                                                         Foreground="{DynamicResource Accent}"/>
                                            <TextBlock x:Name="DashTodayCap" Text="目标 100 GB" FontSize="10.5"
                                                       Foreground="{DynamicResource Dim}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="4" BorderBrush="{DynamicResource Border}"
                                            BorderThickness="1,0,0,0" Padding="18,14">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="完成率" Style="{StaticResource DashKicker}"/>
                                            <TextBlock x:Name="DashRate" Text="0%" FontSize="20"
                                                       FontFamily="{StaticResource MonoFont}" FontWeight="SemiBold"/>
                                            <ProgressBar x:Name="DashRateBar" Height="3" Margin="0,7,0,0"
                                                         Maximum="100" Value="0"
                                                         Foreground="{DynamicResource Green}"/>
                                            <TextBlock x:Name="DashRateCap" Text="0 / 0 项" FontSize="10.5"
                                                       Foreground="{DynamicResource Dim}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- 队列工具条 -->
                            <Grid Grid.Row="2" Margin="22,14,22,10" Height="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Style="{StaticResource SegmentedBar}" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="TabAll" Style="{StaticResource Segmented}" GroupName="Tab"
                                                     IsChecked="True" Checked="Tab_Checked">
                                            <StackPanel Orientation="Horizontal">
                                                <ctrl:VectorIcon Kind="list" Width="11" Height="11" VerticalAlignment="Center" Foreground="{DynamicResource Dim}"/>
                                                <TextBlock Text="全部" Margin="6,0,0,0"/>
                                                <TextBlock x:Name="CountAll" Text="0" Margin="6,0,0,0" FontSize="10"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="TabActive" Style="{StaticResource Segmented}" GroupName="Tab"
                                                     Checked="Tab_Checked">
                                            <StackPanel Orientation="Horizontal">
                                                <ctrl:VectorIcon Kind="download" Width="11" Height="11" VerticalAlignment="Center" Foreground="{DynamicResource Dim}"/>
                                                <TextBlock Text="下载中" Margin="6,0,0,0"/>
                                                <TextBlock x:Name="CountActive" Text="0" Margin="6,0,0,0" FontSize="10"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="TabQueued" Style="{StaticResource Segmented}" GroupName="Tab"
                                                     Checked="Tab_Checked">
                                            <StackPanel Orientation="Horizontal">
                                                <ctrl:VectorIcon Kind="clock" Width="11" Height="11" VerticalAlignment="Center" Foreground="{DynamicResource Dim}"/>
                                                <TextBlock Text="排队中" Margin="6,0,0,0"/>
                                                <TextBlock x:Name="CountQueued" Text="0" Margin="6,0,0,0" FontSize="10"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="TabDone" Style="{StaticResource Segmented}" GroupName="Tab"
                                                     Checked="Tab_Checked">
                                            <StackPanel Orientation="Horizontal">
                                                <ctrl:VectorIcon Kind="check-circle" Width="11" Height="11" VerticalAlignment="Center" Foreground="{DynamicResource Dim}"/>
                                                <TextBlock Text="已完成" Margin="6,0,0,0"/>
                                                <TextBlock x:Name="CountDone" Text="0" Margin="6,0,0,0" FontSize="10"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="TabPaused" Style="{StaticResource Segmented}" GroupName="Tab"
                                                     Checked="Tab_Checked">
                                            <StackPanel Orientation="Horizontal">
                                                <ctrl:VectorIcon Kind="alert-circle" Width="11" Height="11" VerticalAlignment="Center" Foreground="{DynamicResource Dim}"/>
                                                <TextBlock Text="异常" Margin="6,0,0,0"/>
                                                <TextBlock x:Name="CountPaused" Text="0" Margin="6,0,0,0" FontSize="10"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>
                                </Border>

                                <!-- 搜索 -->
                                <Border Grid.Column="1" Width="200" Height="30" Margin="10,0,0,0"
                                        VerticalAlignment="Center" CornerRadius="7"
                                        Background="{DynamicResource FieldBg}"
                                        BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                    <Grid Margin="9,0,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <ctrl:VectorIcon Kind="search" Width="13" Height="13" Foreground="{DynamicResource Dim}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <Grid Grid.Column="1">
                                            <TextBox x:Name="TaskSearchBox" BorderThickness="0" Background="Transparent"
                                                     VerticalContentAlignment="Center" FontSize="11.5"
                                                     Foreground="{DynamicResource Text}"
                                                     CaretBrush="{DynamicResource Accent}"
                                                     TextChanged="TaskSearch_TextChanged"/>
                                            <TextBlock Text="搜索文件名 / 来源" FontSize="11.5"
                                                       IsHitTestVisible="False"
                                                       Foreground="{DynamicResource Dim}"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text, ElementName=TaskSearchBox}"
                                                                         Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <ComboBox x:Name="SortCombo" Grid.Column="3" Style="{StaticResource DarkCombo}"
                                          Width="112" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <ComboBoxItem Content="按添加时间"/>
                                    <ComboBoxItem Content="按名称"/>
                                    <ComboBoxItem Content="按进度"/>
                                </ComboBox>

                                <Button Grid.Column="4" Style="{StaticResource MiniBtn}" Height="30"
                                        Margin="0,0,6,0" Click="BatchSelectAll_Click" ToolTip="选中当前列表全部任务">
                                    <StackPanel Orientation="Horizontal">
                                        <ctrl:VectorIcon Kind="check-square" Width="13" Height="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="全选" Margin="5,0,0,0" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="5" Style="{StaticResource MiniBtn}" Height="30"
                                        Margin="0,0,6,0" Click="NewTask_Click" ToolTip="回到输入框添加新任务">
                                    <StackPanel Orientation="Horizontal">
                                        <ctrl:VectorIcon Kind="plus" Width="13" Height="13" VerticalAlignment="Center"/>
                                        <TextBlock Text="添加任务" Margin="5,0,0,0" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="6" Style="{StaticResource IconBtn}"
                                        Click="ToggleLog_Click" ToolTip="运行日志">
                                    <ctrl:VectorIcon Kind="terminal" Width="16" Height="16"/>
                                </Button>
                            </Grid>

                            <!-- 任务列表 -->
                            <Border Grid.Row="3" Margin="22,0,22,14" Background="Transparent"
                                    BorderThickness="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- 多选批量操作条：按住 Ctrl / Shift 多选任务后出现 -->
                                    <Border x:Name="BatchBar" Grid.Row="0" Visibility="Collapsed"
                                            Background="{DynamicResource Surface2}"
                                            BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                                            Padding="14,8">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock x:Name="BatchCount" Text="已选 0 项" FontSize="12"
                                                       Foreground="{DynamicResource Sub}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Button Content="全选" Style="{StaticResource TextBtn}" Click="BatchSelectAll_Click"/>
                                            <Button Content="暂停" Style="{StaticResource TextBtn}" Click="BatchPause_Click"/>
                                            <Button Content="继续" Style="{StaticResource TextBtn}" Click="BatchResume_Click"/>
                                            <Button Content="删除" Style="{StaticResource DangerGhost}" Click="BatchRemove_Click"/>
                                            <Button Content="取消选择" Style="{StaticResource TextBtn}" Click="BatchClear_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <ListBox x:Name="TaskList" PreviewMouseWheel="InnerList_PreviewMouseWheel" Grid.Row="1" Background="Transparent" BorderThickness="0"
                                             SelectionMode="Extended"
                                             ItemTemplateSelector="{StaticResource RowSelector}"
                                             VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                             Padding="0,2"
                                             IsSynchronizedWithCurrentItem="False"
                                             ItemContainerStyle="{StaticResource RowItem}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.CanContentScroll="True"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                             SelectionChanged="TaskList_SelectionChanged">
                                        <ListBox.GroupStyle>
                                            <GroupStyle ContainerStyle="{StaticResource QueueGroupHost}">
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="4,14,4,8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}"
                                                                       Style="{StaticResource QueueGroupHeader}" Margin="0"/>
                                                            <Border Grid.Column="1" Background="{DynamicResource Surface3}"
                                                                    CornerRadius="5" Padding="6,1" Margin="8,0,0,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ItemCount}" FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource Sub}"/>
                                                            </Border>
                                                            <Border Grid.Column="2" Height="1" Margin="12,0"
                                                                    Background="{DynamicResource Border}"
                                                                    VerticalAlignment="Center"/>
                                                            <Button Grid.Column="3"
                                                                    Style="{StaticResource TextBtn}"
                                                                    Click="GroupAction_Click"
                                                                    Tag="{Binding Name}">
                                                                <TextBlock FontSize="11">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="查看全部 →"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Name}" Value="正在下载">
                                                                                    <Setter Property="Text" Value="全部暂停"/>
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Name}" Value="队列中">
                                                                                    <Setter Property="Text" Value="全部开始"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Button>
                                                        </Grid>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ListBox.GroupStyle>
                                    </ListBox>

                                    <StackPanel x:Name="EmptyHint" Grid.Row="1" VerticalAlignment="Center"
                                                HorizontalAlignment="Center" Visibility="Collapsed">
                                        <Border Width="52" Height="52" CornerRadius="16"
                                                Background="{DynamicResource Surface2}" HorizontalAlignment="Center">
                                            <ctrl:VectorIcon Kind="download" Width="23" Height="23" Foreground="{DynamicResource Dim}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="队列是空的" Margin="0,14,0,0" FontSize="13"
                                                   Foreground="{DynamicResource Sub}" HorizontalAlignment="Center"/>
                                        <TextBlock Text="把链接粘到上面的输入框，或直接把链接拖进窗口"
                                                   Style="{StaticResource DimText}" Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
</ScrollViewer>

                        <!-- ================= 历史 ================= -->
                        <ScrollViewer x:Name="HistoryScroll" Focusable="False" Visibility="{Binding Visibility, ElementName=ViewHistory}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
<Grid x:Name="ViewHistory" Visibility="Collapsed" Margin="22,18,22,14" MaxWidth="1280" HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="2,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="已完成" Style="{StaticResource H1}"/>
                                    <TextBlock x:Name="HistorySubText" Text="完成、失败、已停止的任务都在这里"
                                               Style="{StaticResource DimText}" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Button Style="{StaticResource MiniBtn}" Margin="0,0,6,0"
                                            Click="ExportHistory_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <ctrl:VectorIcon Kind="file-text" Width="13" Height="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="导出 CSV" Margin="5,0,0,0" FontSize="11"/>
                                        </StackPanel>
