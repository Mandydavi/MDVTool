                                                            <Button Content="去下载列表" Style="{StaticResource MiniBtn}"
                                                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                    Click="GoTasks_Click"/>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

<!-- ================= 设置（单页分节） ================= -->
