                        <!-- 打赏弹层：应用内展示收款码，不跳浏览器 -->
                        

<!-- ================= 资源嗅探 ================= -->
                        <Grid x:Name="ViewSniff" Visibility="Collapsed" Margin="22,18,22,14">
