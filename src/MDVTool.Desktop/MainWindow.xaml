                                            <TextBlock x:Name="LibTitle" Text="0 个文件"/>
                                        </Border>
                                        <Border Grid.Column="2" Height="1" Background="{DynamicResource Border}"
                                                VerticalAlignment="Center" Margin="12,0"/>
                                        <TextBlock Grid.Column="3" Text="双击在资源管理器打开"
                                                   FontSize="10.5" Foreground="{DynamicResource Dim}"/>
