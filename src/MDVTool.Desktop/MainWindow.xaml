                                            <TextBlock Text="粘一条磁力链接，点开始试试" FontSize="11.5"
                                                       Foreground="{DynamicResource Dim}"
                                                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
