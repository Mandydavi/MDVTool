                                                            <CheckBox x:Name="QueueBoost" Style="{StaticResource Switch}"
                                                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                      Click="QueueSwitch_Click"/>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>

                                            <Border Style="{StaticResource SettingCard}" Margin="0,14,0,0">
