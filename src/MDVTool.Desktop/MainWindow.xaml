                                                <StackPanel Orientation="Horizontal">
                                                    <ctrl:VectorIcon Kind="stop" Width="13" Height="13" VerticalAlignment="Center"
                                                               Margin="0,0,5,0"/>
                                                    <TextBlock Text="全部停止" FontSize="11"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <Border Height="1" Background="{DynamicResource BorderSoft}"
                                                VerticalAlignment="Center" Margin="90,0,96,0"/>
                                    </Grid>

                                    <Border x:Name="BtProgressCard" Visibility="Collapsed"
                                            Background="{DynamicResource Card}" CornerRadius="13"
                                            BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                            Padding="16,14">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
