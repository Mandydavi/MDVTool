                                                           HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="2,22,2,10">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="BT 任务" FontSize="12" FontWeight="Bold"/>
                                            <Border Style="{StaticResource NavCount}" Margin="8,0,0,0">
