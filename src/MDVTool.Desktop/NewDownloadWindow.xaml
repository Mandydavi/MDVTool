<Window x:Class="MDVTool.NewDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:MDVTool.Controls"
        Title="新建下载" Width="880" Height="596"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False">

    <Border Background="{DynamicResource Bg}" CornerRadius="18" Margin="18"
            BorderBrush="{DynamicResource Border}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.30"
                              Color="{DynamicResource Shadow}"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 标题条 -->
            <Grid Grid.Row="0" Height="62" Background="Transparent" MouseLeftButtonDown="Header_Drag">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource BrandGrad}">
                        <ctrl:VectorIcon Kind="download" Width="15" Height="15" Foreground="White"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="新建下载" FontSize="16" FontWeight="Bold" Margin="12,0,0,0"
                               VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource AccentSoft}" CornerRadius="7" Padding="8,3"
                            Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ProtoPill" Text="HTTP" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Accent}"/>
                    </Border>
                </StackPanel>
                <Button Style="{StaticResource WinCloseBtn}" HorizontalAlignment="Right"
                        VerticalAlignment="Top" Margin="0,8,8,0" Click="Cancel_Click"/>
            </Grid>

            <!-- 主体 -->
            <Grid Grid.Row="1" Margin="24,4,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="248"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- 地址 -->
                        <Border Style="{StaticResource SettingCard}" Padding="20,18">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <ctrl:VectorIcon Kind="link" Width="14" Height="14" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="下载地址" FontSize="13.5" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="URL" FontSize="12.5" Foreground="{DynamicResource Dim}"
                                               VerticalAlignment="Center"/>
                                    <TextBox x:Name="UrlBox" Grid.Column="1"
                                             Height="40" TextChanged="UrlBox_TextChanged"
                                             VerticalContentAlignment="Center"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="识别" FontSize="12.5" Foreground="{DynamicResource Dim}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock x:Name="DetectText" Grid.Column="1" FontSize="12.5"
                                               Foreground="{DynamicResource Sub}" VerticalAlignment="Center"
                                               Text="等待输入链接…" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 保存与分类 -->
                        <Border Style="{StaticResource SettingCard}" Padding="20,18" Margin="0,14,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <ctrl:VectorIcon Kind="folder" Width="14" Height="14" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="保存与分类" FontSize="13.5" FontWeight="SemiBold" Margin="8,0,0,0"/>
                                </StackPanel>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="分类" FontSize="12.5" Foreground="{DynamicResource Dim}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="CatCombo" Grid.Column="1" Style="{StaticResource BoxCombo}"
                                              Height="38" SelectionChanged="CatCombo_Changed"/>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="另存为" FontSize="12.5" Foreground="{DynamicResource Dim}"
                                               VerticalAlignment="Center"/>
                                    <TextBox x:Name="DirBox" Grid.Column="1"
                                             Height="38" VerticalContentAlignment="Center"/>
                                    <Button Grid.Column="2" Content="浏览…" Style="{StaticResource MiniBtn}"
                                            Margin="8,0,0,0" Height="38" Padding="14,0" Click="Browse_Click"/>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="线程" FontSize="12.5" Foreground="{DynamicResource Dim}"
                                               VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <ComboBox x:Name="ConnCombo" Style="{StaticResource BoxCombo}"
                                                  Width="180" Height="38">
                                            <ComboBoxItem Content="自动（测速选最快）"/>
                                            <ComboBoxItem Content="4 线程"/>
                                            <ComboBoxItem Content="8 线程"/>
                                            <ComboBoxItem Content="16 线程"/>
                                            <ComboBoxItem Content="32 线程"/>
                                            <ComboBoxItem Content="64 线程（极速）"/>
                                        </ComboBox>
                                        <TextBlock Text="仅对本次生效，也会写回默认设置" FontSize="11.5"
                                                   Foreground="{DynamicResource Dim}" VerticalAlignment="Center"
                                                   Margin="12,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 右侧预览 -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource SettingCard}" Padding="20,22">
                        <StackPanel>
                            <Border Width="66" Height="66" CornerRadius="16" Background="{DynamicResource BrandGrad}"
                                    HorizontalAlignment="Center">
                                <TextBlock x:Name="ExtText" Text="ZIP" Foreground="White" FontSize="15"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="NameText" Text="等待输入链接" FontSize="13.5" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,14,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                            <TextBlock x:Name="HostText" Text="—" FontSize="12" Foreground="{DynamicResource Dim}"
                                       HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"
                                       MaxWidth="200"/>
                        </StackPanel>
                    </Border>

                    <Button Content="开始下载" Style="{StaticResource Primary}" Height="44" Margin="0,16,0,0"
                            Click="Start_Click"/>
                    <Button Content="取消" Style="{StaticResource Ghost}" Height="44" Margin="0,10,0,0"
                            Click="Cancel_Click"/>
                    <TextBlock Text="粘链接直接回车也能开始" FontSize="11" Foreground="{DynamicResource Dim}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 底部提示 -->
            <Border Grid.Row="2" Margin="24,14,24,20" Padding="14,10" CornerRadius="12"
                    Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <ctrl:VectorIcon Kind="zap" Width="13" Height="13" VerticalAlignment="Center"
                                     Foreground="{DynamicResource Gold}"/>
                    <TextBlock Text="支持 HTTP / HTTPS / 磁力 / .torrent / 视频页；模型会自动归到 ComfyUI 对应目录"
                               FontSize="11.5" Foreground="{DynamicResource Sub}" Margin="8,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
